<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f1f5f9">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#0d6e4e" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dompet Digital" android:textColor="white" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/saldoText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textColor="white" android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/poinText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 poin" android:textColor="#a7d4c4" android:textSize="14sp" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Riwayat Transaksi" android:textSize="16sp" android:textStyle="bold" android:textColor="#1e293b" android:padding="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
