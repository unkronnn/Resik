<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f1f5f9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:background="white" android:padding="24dp" android:elevation="2dp">
            <TextView android:layout_width="64dp" android:layout_height="64dp" android:text="R" android:textSize="24sp" android:textStyle="bold" android:textColor="white" android:background="#0d6e4e" android:gravity="center" android:layout_marginEnd="16dp" />
            <TextView android:id="@+id/namaUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nama Pengguna" android:textSize="18sp" android:textStyle="bold" android:textColor="#1e293b" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Informasi Akun" android:textSize="14sp" android:textStyle="bold" android:textColor="#64748b" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="white" android:padding="20dp" android:elevation="2dp">
            <TextView android:id="@+id/emailUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email: -" android:textSize="14sp" android:textColor="#334155" android:paddingBottom="12dp" />
            <TextView android:id="@+id/alamatUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alamat: -" android:textSize="14sp" android:textColor="#334155" android:paddingBottom="12dp" />
            <TextView android:id="@+id/telpUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No. Telepon: -" android:textSize="14sp" android:textColor="#334155" android:paddingBottom="12dp" />
            <TextView android:id="@+id/roleUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Role: MASYARAKAT" android:textSize="14sp" android:textColor="#334155" />
        </LinearLayout>

        <Button android:id="@+id/editBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Edit Profil" android:backgroundTint="#0d6e4e" android:textColor="white" android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
