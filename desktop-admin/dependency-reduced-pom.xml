<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.resik</groupId>
  <artifactId>resik-desktop</artifactId>
  <name>RESIK Desktop Admin</name>
  <version>1.0.0</version>
  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.resik.admin.ResikDesktopApp</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.resik.admin.ResikDesktopApp</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <minimizeJar>false</minimizeJar>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>exe</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-jpackage-plugin</artifactId>
            <version>3.6.4</version>
            <configuration>
              <mainClass>com.resik.admin.ResikDesktopApp</mainClass>
              <type>EXE</type>
              <name>RESIK-Admin</name>
              <appVersion>1.0.0</appVersion>
              <vendor>RESIK</vendor>
              <description>RESIK Bank Sampah Digital - Admin Desktop</description>
              <icon>${project.basedir}/src/main/resources/resik-icon.ico</icon>
              <winMenu>true</winMenu>
              <winMenuGroup>RESIK</winMenuGroup>
              <winShortcut>true</winShortcut>
              <winDirChooser>true</winDirChooser>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <properties>
    <maven.compiler.target>17</maven.compiler.target>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.2</javafx.version>
  </properties>
</project>
